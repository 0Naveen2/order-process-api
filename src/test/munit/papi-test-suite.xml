<!-- TEST CASE 6: Global Error Handler DLQ Publish Failure Path -->

<munit:test
    name="order-process-queue-listener-flow-dlq-publish-failure-test"
    description="Verify invalid operation enters global error handler and AMQP DLQ publish failure is consumed by Catch DLQ Publish Failure">

    <munit:behavior>

        <munit-tools:mock-when
            doc:name="Mock DLQ Publish AMQP Connectivity Error"
            processor="amqp:publish">

            <munit-tools:with-attributes>
                <munit-tools:with-attribute
                    attributeName="doc:name"
                    whereValue="#['Publish Message to DLQ']"/>
            </munit-tools:with-attributes>

            <munit-tools:then-return>
                <munit-tools:error typeId="AMQP:CONNECTIVITY"/>
            </munit-tools:then-return>

