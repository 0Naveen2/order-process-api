    <munit:config name="order-process-api-test-suite"/>

    <!-- TEST CASE 1: Main Flow CREATE Success Path -->

    <munit:test
        name="order-process-queue-listener-flow-create-success-test"
        description="Verify CREATE command executes main flow, create-order-subflow, email subflow, and completes successfully">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock DB SAPI POST Request"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Call DB SAPI - POST /orders']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

    <munit-tools:payload
        value='#[{
            orderId: "ORD-MUNIT-001",
            orderTotal: 100,
            unitPrice: 50
        }]'
        mediaType="application/java"/>

    <munit-tools:variables>
        <munit-tools:variable
            key="sapiResponse"
            value='#[{
                orderId: "ORD-MUNIT-001",
                orderTotal: 100,
                unitPrice: 50
            }]'
            mediaType="application/java"/>
    </munit-tools:variables>

</munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when
                doc:name="Mock Notification Email"
                processor="email:send">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Send Notification Email']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return/>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set CREATE Queue Message">

    <munit:payload
        mediaType="application/json"
        value='#[write({
            correlationId: "test-corr-001",
            operation: "CREATE",
            orderId: "",
            payload: {
                customerId: "CUST-001",
                customerName: "John Doe",
                customerEmail: "john.doe@example.com",
                orderDate: "2026-10-11",
                productCode: "PROD-001",
                quantity: 2,
                currency: "USD",
                shippingAddressLine1: "123 Main Street",
                shippingAddressLine2: null,
                shippingCity: "Hyderabad",
                shippingState: "Telangana",
                shippingPostalCode: "500019",
                shippingCountry: "India"
            }
        }, "application/json")]'/>

</munit:set-event>

            <flow-ref
                name="order-process-queue-listener-flow"
                doc:name="Invoke order-process-queue-listener-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert operation is CREATE"
                expression="#[vars.operation]"
                is="#[MunitTools::equalTo('CREATE')]"/>

            <munit-tools:assert-that
                doc:name="Assert correlationId"
                expression="#[vars.correlationId]"
                is="#[MunitTools::equalTo('test-corr-001')]"/>

            <munit-tools:assert-that
                doc:name="Assert rawMessage exists"
                expression="#[vars.rawMessage != null]"
                is="#[MunitTools::equalTo(true)]"/>

            <munit-tools:assert-that
                doc:name="Assert orderPayload exists"
                expression="#[vars.orderPayload != null]"
                is="#[MunitTools::equalTo(true)]"/>

            <munit-tools:assert-that
                doc:name="Assert created orderId"
                expression="#[vars.orderId]"
                is="#[MunitTools::equalTo('ORD-MUNIT-001')]"/>

            <munit-tools:assert-that
                doc:name="Assert calculatedTotal"
                expression="#[vars.calculatedTotal]"
                is="#[MunitTools::equalTo(100)]"/>

            <munit-tools:assert-that
                doc:name="Assert unitPrice"
                expression="#[vars.unitPrice]"
                is="#[MunitTools::equalTo(50)]"/>

            <munit-tools:assert-that
                doc:name="Assert email subject"
                expression="#[vars.emailSubject]"
                is="#[MunitTools::equalTo('Order Confirmation - #ORD-MUNIT-001')]"/>

            <munit-tools:assert-that
                doc:name="Assert target email"
                expression="#[vars.targetEmail]"
                is="#[MunitTools::equalTo('john.doe@example.com')]"/>

            <munit-tools:verify-call
                doc:name="Verify DB SAPI POST called once"
                processor="http:request"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Call DB SAPI - POST /orders']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                doc:name="Verify notification email called once"
                processor="email:send"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Send Notification Email']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>
    
